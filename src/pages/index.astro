---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { faqPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getLandingFaqs } from '../data/faq';
import {
  MOBILE_HERO_IMAGE_SIZES,
  responsiveSrcSet,
  webpSrc,
} from '../utils/responsiveImage';

const seo = resolvePageSeo('/');
const homeFaqs = getLandingFaqs();
const heroLcpSrc = '/images/gameplay/dayz-esp-wallhack.png';
const heroLcpMobile = webpSrc(heroLcpSrc, 320);
const heroLcpMobileSrcSet = responsiveSrcSet(heroLcpSrc, [320]);
const heroLcpDesktop = webpSrc(heroLcpSrc, 640);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[websiteSchema(), organizationSchema(), faqPageSchema(homeFaqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))]}
>
  <meta
    slot="head"
    name="keywords"
    content="DayZ cheats, cheats dayz, DayZ Standalone cheats, DayZ ESP cheat, DayZ aimbot cheat, DayZ radar cheat, dayz cheats pc"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpMobile}
    imagesrcset={heroLcpMobileSrcSet}
    imagesizes={MOBILE_HERO_IMAGE_SIZES}
    type="image/webp"
    media="(max-width: 1023px)"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpDesktop}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
