---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';

import LegalPage from '../components/LegalPage.astro';
import SocialShare from '../components/SocialShare.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/about/');
const content = t.legalPages.about;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    organizationSchema(),
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/about/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about/' },
    ]),
  ]}
>
  <LegalPage
    title={seo.title}
    description={seo.description}
    breadcrumbLabel="About"
    sections={content.sections}
  />
  <section class="border-t border-border bg-muted/10 py-8">
    <div class="mx-auto max-w-3xl px-5">
      <SocialShare pathname={Astro.url.pathname} title={seo.title} />
    </div>
  </section>
</BaseLayout>
