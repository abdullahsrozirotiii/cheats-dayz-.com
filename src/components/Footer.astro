---
import { t } from '../i18n';
import { Separator } from '@/components/starwind/separator';
import BrandLogo from './BrandLogo.astro';
import SocialShare from './SocialShare.astro';

interface Props {
  pathname?: string;
  pageTitle?: string;
}

const { pathname = '/', pageTitle = t.site.title } = Astro.props;

const resourceLinks = [
  { href: '/blog/', label: 'Patch-day articles', ariaLabel: 'Blog archive' },
  { href: '/products/dayz-cheats/elite/', label: 'Elite tier details', ariaLabel: 'Elite cheats' },
  { href: '/products/dayz-cheats/utilities/', label: 'HWID & UGC utilities', ariaLabel: 'Utilities' },
  { href: '/support/', label: 'Loader & checkout help', ariaLabel: 'Support' },
];

const legalLinks = [
  { href: '/about/', label: t.footer.about },
  { href: '/privacy/', label: t.footer.privacy },
  { href: '/terms/', label: t.footer.terms },
];
---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="space-y-4">
        <a
          href="/"
          class="inline-flex min-w-0 items-center py-0.5"
          aria-label={t.ui.homeAria}
        >
          <BrandLogo class="h-7 w-auto max-w-[8rem] object-contain object-left sm:max-w-[9rem]" />
        </a>
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground hover:text-primary"
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary" aria-label={link.ariaLabel}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <SocialShare pathname={pathname} title={pageTitle} />
    </div>

    <Separator class="my-8" />
    <p class="text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
