---
import { t } from '../i18n';
import { Separator } from '@/components/starwind/separator';
import BrandLogo from './BrandLogo.astro';
---

<footer class="site-footer border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="site-footer__grid grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="site-footer__brand space-y-4">
        <a
          href="/"
          class="inline-flex min-w-0 items-center py-0.5"
          aria-label={t.ui.homeAria}
        >
          <BrandLogo class="h-7 w-auto max-w-[8rem] object-contain object-left sm:max-w-[9rem]" />
        </a>
        <p class="site-footer__tagline text-sm leading-relaxed text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav class="site-footer__nav" aria-label={t.footer.explore}>
        <p class="site-footer__heading text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          {t.footer.explore}
        </p>
        <ul class="mt-3 space-y-2">
          {
            t.footer.exploreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="site-footer__link text-sm text-muted-foreground transition-colors hover:text-primary"
                  {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="site-footer__nav" aria-label={t.footer.support}>
        <p class="site-footer__heading text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          {t.footer.support}
        </p>
        <ul class="mt-3 space-y-2">
          {
            t.footer.supportLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="site-footer__link text-sm text-muted-foreground transition-colors hover:text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="site-footer__nav" aria-label={t.footer.legal}>
        <p class="site-footer__heading text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          {t.footer.legal}
        </p>
        <ul class="mt-3 space-y-2">
          {
            t.footer.legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="site-footer__link text-sm text-muted-foreground transition-colors hover:text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <Separator class="site-footer__rule my-8" />
    <p class="site-footer__copy text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
