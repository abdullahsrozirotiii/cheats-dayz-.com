---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  centered?: boolean;
  wide?: boolean;
  /** Use 1 only for the page’s primary heading (e.g. FAQ). Default 2 for landing sections. */
  headingLevel?: 1 | 2;
}

const { eyebrow, title, desc, titleId, centered = false, wide = false, headingLevel = 2 } = Astro.props;
const TitleTag = headingLevel === 1 ? 'h1' : 'h2';
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <TitleTag id={titleId} class="section-header__title">{title}</TitleTag>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
